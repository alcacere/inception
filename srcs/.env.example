# .env.example: committed template. `make secrets` copies it to srcs/.env (git-ignored).
# Non-secret configuration only: passwords live in secrets/*.txt.
# Format: KEY=value, with no spaces around '=' and no `export`.

# Project identity
LOGIN=alcacere
DOMAIN_NAME=alcacere.42.fr
DATA_PATH=/home/alcacere/data

# MariaDB: the database wordpress uses, and the account it connects with
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_dbuser

# wordpress: site accounts, stored in the wp_users table
WP_TITLE=Inception
WP_ADMIN_USER=alcacere
WP_ADMIN_EMAIL=alcacere@example.com
WP_USER=wp_author
WP_USER_EMAIL=wp_author@example.com
WP_USER_ROLE=author

# TLS certificate
CERT_COUNTRY=ES
CERT_STATE=Madrid
CERT_CITY=Madrid
CERT_ORG=42
CERT_UNIT=student

# Bonus services
REDIS_HOST=redis
REDIS_PORT=6379
FTP_USER=ftp_user
FTP_PASV_MIN=21000
FTP_PASV_MAX=21010
FTP_PASV_ADDRESS=192.168.56.42
PROMETHEUS_RETENTION=7d
